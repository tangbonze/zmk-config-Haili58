#include "haili58-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zephyr,display = &oled;
    };

    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };
};

&physical_layout_haili58 {
    transform = <&matrix_transform0>;
};

// Encoders for all parts of the keyboard.
// If the encoder(s) are not behaving as expected,
// update steps and triggers-per-rotation to match your hardware.
// All pin assignments are done in the part overlays.

/ {
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

        right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};

// Rotary encoder positions for the DYA Studio keyboard preview.
//
// CONFIG_ZMK_PHYSICAL_LAYOUTS_FEATURE (zmk-feature-module-physical-layout)
// draws these on top of the official ZMK key physical layout. Coordinates use
// the same unit as `haili58-layouts.dtsi` above: one key is 100 x 100, and the
// whole keyboard spans x = 0..1650, y = 0..600.
//
// The order of `encoders` is the sensor index used by `sensor-bindings` in the
// keymap, i.e. 0 = left encoder, 1 = right encoder. The knobs are placed in the
// empty outer bottom corner, below the outer column and outboard of the thumb
// arc. Move the x/y values if yours sit elsewhere — this is preview art, and
// nothing else in the firmware depends on it. Mirror the other half with
// x = 1650 - x_left - size.
/ {
    dya_rotary_encoders: dya_rotary_encoders {
        compatible = "cormoran,physical-layout-rotary-encoders";
        display-name = "Rotary Encoders";
        encoders = <&dya_encoder_left &dya_encoder_right>;
    };

    dya_encoder_left: dya_encoder_left {
        compatible = "cormoran,physical-layout-rotary-encoder";
        size = <120>;
        x = <150>;
        y = <470>;
    };

    dya_encoder_right: dya_encoder_right {
        compatible = "cormoran,physical-layout-rotary-encoder";
        size = <120>;
        x = <1380>;
        y = <470>;
    };
};

