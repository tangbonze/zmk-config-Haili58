#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Runtime macros edited from DYA Studio are bound with `&rmacro <slot>`.
#include <behaviors/runtime_macro.dtsi>

// Runtime-configurable encoder bindings (DYA Studio keymap view -> click a
// knob -> "Rotary Encoder Configuration").
// The include also pulls in &rsr_trans: a sensor behavior with no default
// binding that still accepts a per-layer one at runtime.
#include <behaviors/runtime-sensor-rotate.dtsi>

/ {
    behaviors {
        // Left knob (sensor 0). Defaults are the ones this keyboard shipped
        // with, so nothing changes until someone edits them in Studio.
        rsr_left: rsr_left {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        // Right knob (sensor 1).
        rsr_right: rsr_right {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp UP>;
            ccw-binding = <&kp DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4  &kp NUMBER_5        &kp NUMBER_6    &kp N7      &kp N8     &kp N9   &kp N0     &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E          &kp R         &kp T               &kp Y           &kp U       &kp I      &kp O    &kp P      &kp LBKT
&kp LEFT_CONTROL  &kp A         &kp S         &kp D          &kp F         &kp G               &kp H           &kp J       &kp K      &kp L    &kp SEMI   &kp APOS
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C          &kp V         &kp B               &kp N           &kp M       &kp COMMA  &kp DOT  &kp FSLH   &kp ENTER
&kp LEFT_ALT      &kp LEFT_GUI  &kp SPACE     &kp RIGHT_ALT  &mo 1         &studio_unlock      &studio_unlock  &kp DELETE  &mo 1      &mo 2    &kp MINUS  &kp EQUAL
            >;

            // Order here is the sensor index: 0 = left knob, 1 = right knob.
            //
            // EVERY layer needs a sensor-bindings entry that points at a
            // runtime-sensor-rotate instance. A layer without one (or with
            // &trans) is skipped by the keymap, so Studio can happily save a
            // binding for it and nothing will ever happen.
            // &rsr_trans means "no default, but runtime-configurable".
            sensor-bindings = <&rsr_left &rsr_right>;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5      &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &trans
&trans     &kp F11  &kp F12  &trans  &trans  &trans      &trans  &trans    &kp UP    &trans     &trans   &kp RBKT
&trans     &trans   &trans   &trans  &trans  &trans      &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &kp DOUBLE_QUOTES
&trans     &trans   &trans   &trans  &trans  &trans      &trans  &trans    &trans    &trans     &trans   &trans
&trans     &trans   &trans   &trans  &trans  &trans      &trans  &trans    &trans    &trans     &trans   &trans
            >;

            // No default binding, but configurable from the Studio tab. Until
            // one is set the rotation falls through to the base layer.
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp INS  &kp HOME         &kp PAGE_UP  &kp PAGE_DOWN  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp END  &kp PRINTSCREEN  &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
            >;

            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        // Reserved layers are ignored by a normal build but become editable
        // from ZMK Studio / DYA Studio. See
        // https://zmk.dev/docs/features/studio#including-extra-layers
        //
        // They carry a runtime-sensor-rotate binding too, so that if one of
        // them is brought to life from Studio its knobs can be configured
        // instead of silently doing nothing.
        layer_3 {
            status = "reserved";
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        layer_4 {
            status = "reserved";
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };
    };
};
